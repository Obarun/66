# 66 as an init inside a container, built on Alpine.
#
#   docker build -f dockerfile.alpine -t 66-alpine .
#   docker run -d --name my66 --cap-add SYS_ADMIN 66-alpine
#   docker exec my66 66 tree status          # inspect the running system
#   docker exec my66 66 halt                 # pid 1 exits with the halt file's EXITCODE
#
# Alpine ships the skarnet packages but not oblibs/66/66-tools. 66 does NOT need
# the skarnet -dev packages: it builds against oblibs only and, at run time,
# needs just the execline binaries. So execline comes from apk and oblibs, 66 and
# 66-tools are built from source. Any Alpine release works; the skarnet package
# versions are irrelevant to 66.
#
# See doc/66-container.html for the full walkthrough.

FROM alpine:3.22

LABEL maintainer="Eric Vidal <eric@obarun.org>"

# Build toolchain, plus execline: the only skarnet runtime dependency of 66.
RUN apk add --no-cache build-base meson ninja pkgconf git linux-headers execline

# oblibs is 66's sole build dependency (self-contained, only libc).
RUN git clone -b dev https://git.obarun.org/obarun/oblibs.git \
 && meson setup oblibs/builddir oblibs --prefix=/usr --libdir=lib \
 && meson compile -C oblibs/builddir \
 && meson install -C oblibs/builddir

# 66 itself. -D 66-log-user runs the loggers as an unprivileged user (root by
# default); we harden that here. -D 66-log-timestamp=iso keeps ISO timestamps.
RUN git clone -b dev https://git.obarun.org/obarun/66.git \
 && meson setup 66/builddir 66 --prefix=/usr --libdir=lib \
      -D 66-log-user=66log -D 66-log-timestamp=iso \
 && meson compile -C 66/builddir \
 && meson install -C 66/builddir

# 66-tools: optional companion commands (66-ns, execl-cmdline, execl-toc).
RUN git clone -b dev https://git.obarun.org/obarun/66-tools.git \
 && meson setup 66-tools/builddir 66-tools --prefix=/usr --libdir=lib \
 && meson compile -C 66-tools/builddir \
 && meson install -C 66-tools/builddir

# Create the unprivileged logger user: a security best practice (the loggers run
# as root otherwise), and 66 cannot create a system account for you (busybox
# addgroup/adduser here). 66 creates the rest of its own state (directories,
# version marker, default "global" tree) by itself on the first boot,
# best-effort -- see the docs if you mount /var/lib read-only.
RUN addgroup -S 66log \
 && adduser -S -D -H -G 66log -s /sbin/nologin 66log

# pid 1: boot the container as a fully supervised 66 system.
CMD ["/usr/bin/66", "boot", "-c"]
