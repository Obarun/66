## fdholder

(( $+functions[_66_cmd_fdholder] )) || _66_cmd_fdholder() {
    local curcontext="$curcontext" state line
    local -a subcommands

    # fdholder_sub[] in ssexec_fdholder_wrapper.c
    subcommands=(
        "start:start the scandir's fdholder daemon"
        "stop:stop the scandir's fdholder daemon"
        "restart:restart the scandir's fdholder daemon"
        'store:store a file descriptor under a name'
        'retrieve:retrieve a descriptor and exec prog'
        'list:list stored descriptor names'
    )

    _arguments -C \
        '(-h --help)'{-h,--help}'[print this help]' \
        '(-o --owner)'{-o,--owner}'[operate on the fdholder of owner]:owner:_users' \
        '1:subcommand:->subcommand' \
        '*::arg:->args'

    case $state in
        (subcommand)
            _describe -t fdholder-subcommands 'fdholder subcommand' subcommands
            ;;
        (args)
            case $line[1] in
                (start|stop|restart)
                    _arguments -s \
                        '(-h --help)'{-h,--help}'[print this help]' \
                        '(-T --timeout)'{-T,--timeout}'[timeout to wait for the service state]:milliseconds:'
                    ;;
                (store)
                    _arguments -s \
                        '(-h --help)'{-h,--help}'[print this help]' \
                        '(-T --timeout)'{-T,--timeout}'[timeout for the operation]:milliseconds:' \
                        '(-d --fd)'{-d,--fd}'[file descriptor to store (default 0)]:number:' \
                        '(-e --expire)'{-e,--expire}'[expiry in seconds (0 = never)]:seconds:' \
                        ':id:'
                    ;;
                (retrieve)
                    _arguments -s \
                        '(-h --help)'{-h,--help}'[print this help]' \
                        '(-T --timeout)'{-T,--timeout}'[timeout for the operation]:milliseconds:' \
                        '(-D --delete)'{-D,--delete}'[delete the entry after retrieval]' \
                        ':id:' \
                        '*:::prog:_normal'
                    ;;
                (list)
                    _arguments -s \
                        '(-h --help)'{-h,--help}'[print this help]' \
                        '(-T --timeout)'{-T,--timeout}'[timeout for the operation]:milliseconds:'
                    ;;
            esac
            ;;
    esac
}

## entry point

_66() {
    local curcontext="$curcontext" state line
    local -a subcommands

    # cmd_reg[] in ssexec_main.c, in the same order
    subcommands=(
        'boot:boot a system with 66'
        'enable:activate services at the next boot'
        'disable:deactivate services at the next boot'
        'start:bring up services'
        'stop:bring down services'
        'configure:manage environment service files and its contents'
        'parse:parse a frontend service file and install its result to resolve files'
        'reconfigure:convenient command to bring down, unsupervise, parse again and bring up services in one pass'
        'reload:convenient command to send a SIGHUP signal to services'
        'restart:convenient command to bring down then bring up services in one pass'
        'free:bring down services and remove them from the scandir'
        'signal:send a signal to services'
        'emit:emit a user event to the event daemon'
        'status:display services informations'
        'log:display service and system logs'
        'resolve:display the resolve file contents of services'
        'state:display state files contents of services'
        'runstate:display runtime status of services'
        'remove:remove services and cleanup all files belong to it from the system'
        'tree:main subcommands to manage trees'
        'snapshot:main subcommands to manage snapshot'
        'scandir:main subcommands to manage scandir'
        'env:main subcommands to manage the runtime environment'
        'fdholder:main subcommands to manage the scandir'\''s fdholder'
        'poweroff:poweroff the system'
        'reboot:reboot the system'
        'halt:halt the system'
        'suspend:suspend the system to RAM'
        'hibernate:hibernate the system to disk'
        'wall:send a message to all logged-in users'
        'version:display the 66 version'
    )

    # opts_main[] in ssexec_main.c. opt_scan is POSIX-ordered, so these are only
    # accepted before the sub-command.
    _arguments -C \
        '(-h --help)'{-h,--help}'[print this help]' \
        '(-v --verbosity)'{-v,--verbosity}'[increase/decrease verbosity]:number:(0 1 2 3 4 5)' \
        '(-l --live)'{-l,--live}'[an absolute path to the live directory]:path:_files -/' \
        '(-t --tree)'{-t,--tree}'[the tree to use]:treename:_66_trees' \
        '(-T --timeout)'{-T,--timeout}'[a timeout in milliseconds]:milliseconds:' \
        '(-z --color)'{-z,--color}'[enable colorization of the output]' \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        (command)
            _describe -t 66-commands '66 command' subcommands
            ;;
        (args)
            curcontext="${curcontext%:*:*}:66-$line[1]:"
            if (( $+functions[_66_cmd_$line[1]] )); then
                _66_cmd_$line[1]
            else
                _default
            fi
            ;;
    esac
}

_66 "$@"
