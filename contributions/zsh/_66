    _arguments -C \
        '(-h --help)'{-h,--help}'[print this help]' \
        '1:subcommand:->subcommand' \
        '*::arg:->args'

    case $state in
        (subcommand)
            _describe -t snapshot-subcommands 'snapshot subcommand' subcommands
            ;;
        (args)
