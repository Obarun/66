(( $+functions[_66_cmd_tree] )) || _66_cmd_tree() {
    local curcontext="$curcontext" state line
    local -a subcommands

    # tree_sub[] in ssexec_tree_wrapper.c
    subcommands=(
        'create:create a tree'
        'admin:administrate an existing tree'
        'remove:remove an existing tree'
        'enable:enable a tree'
        'disable:disable a tree'
        'current:mark a tree as the current one'
        'resolve:display the resolve files contents of tree'
        'status:display information about tree'
        'init:initiate all enabled services of a tree(s) to a scandir'
        'start:bring up all services of a tree'
        'stop:bring down all services of a tree'
        'free:bring down all services of a tree and unsupervise them'
    )

    _arguments -C \
        '(-h --help)'{-h,--help}'[print this help]' \
        '1:subcommand:->subcommand' \
        '*::arg:->args'

    case $state in
        (subcommand)
            _describe -t tree-subcommands 'tree subcommand' subcommands
            ;;
        (args)
            case $line[1] in
                (create|admin)
                    _66_tree_admin_args
                    ;;
                (remove|enable|disable|current|start)
                    _66_tree_only_args
                    ;;
                (stop|free)
                    _66_tree_signal_args
                    ;;
                (resolve)
                    _arguments -s \
                        '(-h --help)'{-h,--help}'[print this help]' \
                        '(-f --field)'{-f,--field}'[display only these comma-separated fields]:field,...:_66_tree_resolve_fields' \
                        '(-n --no-name)'{-n,--no-name}'[display only the value, not the field name]' \
                        ':tree:_66_trees'
                    ;;
                (status)
                    _arguments -s \
                        '(-h --help)'{-h,--help}'[print this help]' \
                        '(-n --no-name)'{-n,--no-name}'[do not display the names of fields]' \
                        '(-f --field)'{-f,--field}'[display only these comma-separated fields]:field,...:_66_tree_status_fields' \
                        '(-g --graph)'{-g,--graph}'[displays the contents field as graph]' \
                        '(-r --reverse)'{-r,--reverse}'[reverse the contents field]' \
                        '(-d --depth)'{-d,--depth}'[limit the depth of the contents field recursion by depth]:number:' \
                        ':tree:_66_trees'
                    ;;
                (init)
                    _arguments -s \
                        '(-h --help)'{-h,--help}'[print this help]' \
                        '(-g --group)'{-g,--group}'[initiate every tree of this group instead of a single tree]:group:_66_tree_groups' \
                        ':tree:_66_trees'
                    ;;
            esac
            ;;
    esac
}

