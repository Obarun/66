#compdef 66

# zsh completion for 66.
#
# Never invoke the 66 binary from here: a 66 command goes through ssexec_main,
# which migrates the live state to the binary's version before running. Every
# candidate list below is therefore either static (mirroring the opt_t tables)
# or read straight from the filesystem.

## helpers

(( $+functions[_66_basedir] )) || _66_basedir() {
    # SS_SYSTEM_DIR for root, SS_USER_DIR under the home otherwise.
    if (( EUID == 0 )); then
        print -r -- /var/lib/66
    else
        print -r -- ${HOME}/.66
    fi
}

# Candidate names are added with compadd, never with _describe: a module member
# is named module:member (scandir@oblive:setenv@oblive) and _describe reads the
# colon as its completion:description separator, which truncates the name and
# collapses every member of a module onto the module itself.

# Frontends: what a command that accepts a not-yet-parsed service takes.
# Those are the commands carrying GRAPH_COLLECT_PARSE (they parse the frontend
# on the fly), plus 66 parse itself.
(( $+functions[_66_frontends] )) || _66_frontends() {
    local -a dirs frontends
    local -aU names
    local expl

    # Same search directories, in the same order, as service_frontend_path().
    if (( EUID == 0 )); then
        dirs=( /etc/66/service /usr/share/66/service )
    else
        dirs=( ${HOME}/.66/service /etc/66/service/user /usr/share/66/service/user )
    fi

    # A frontend is a regular file, a symlink to one, or a directory (a module),
    # searched recursively: a module kept as a directory holds its own frontend
    # one level down (service/scandir/scandir@).
    frontends=( ${^dirs}/**/*(N-.,N-/) )

    # A module's reserved sub-directories hold its internals, not services a
    # user can name; 66's own module parser excludes the same three.
    frontends=( ${frontends:#*/(activated|configure|frontend)(|/*)} )

    # For root, 66 excludes the `user' entry at any depth.
    if (( EUID == 0 )); then
        frontends=( ${frontends:#*/user} )
        frontends=( ${frontends:#*/user/*} )
    fi

    names=( ${frontends:t} )
    (( $#names )) || return 1
    _wanted services expl 'frontend' compadd -a names
}

# Parsed services: every other command either dies on a service that is not
# parsed, or silently ignores it. resolve_check() builds
# <base>/system/.resolve/service/<name> and resolves it through
# service_resolve_symlink(), so an entry that resolves there is exactly what
# "parsed" means -- no need to run 66 to find out. The entries are symlinks to
# the service's resolve directory, hence the symlink-following qualifiers: a
# dangling one would not resolve for 66 either.
(( $+functions[_66_parsed_services] )) || _66_parsed_services() {
    local -aU names
    local expl base=$(_66_basedir)
    names=( ${base}/system/.resolve/service/*(N-.,N-/:t) )
    (( $#names )) || return 1
    _wanted services expl 'service' compadd -a names
}

(( $+functions[_66_trees] )) || _66_trees() {
    local -aU names
    local expl base=$(_66_basedir)
    # A tree is a resolve file sitting next to the Master, which is not a tree.
    names=( ${base}/system/.resolve/*(N.:t) )
    names=( ${names:#Master} )
    (( $#names )) || return 1
    _wanted trees expl 'tree' compadd -a names
}

(( $+functions[_66_snapshots] )) || _66_snapshots() {
    local -aU names
    local expl base=$(_66_basedir)
    names=( ${base}/.snapshot/*(N/:t) )
    (( $#names )) || return 1
    _wanted snapshots expl 'snapshot' compadd -a names
}

(( $+functions[_66_log_operand] )) || _66_log_operand() {
    _alternative \
        'catch-all:catch-all logger:((system\:"the boot/scandir catch-all logger"))' \
        'services:service:_66_parsed_services'
}

